# TUIDC_ENABLETEC. Absent from upstream ADTucsen. Grouped with FanGear because
# both drive the thermal path.
#
# HAZARD -- the TEC's hot side is water cooled, and the AXIS-SXR-40 user manual
# states that a water supply failure means "the sensor would overheat and
# possibly get damaged". Nothing in software can see the coolant loop, so this
# record cannot be interlocked. Do not enable without confirming water flow
# (15-20 C, ~1 l/min). It is also unclear this does anything: the vendor
# capability table marks ENABLETEC as unsupported on 4040/4040BSI even though
# the runtime audit finds it present. Never yet exercised. See the driver source
# and info/TODO.md.
record(mbbo, "$(P)$(R)TECEnable")
{
   field(PINI, "YES")
   field(DTYP, "asynInt32")
   field(OUT,  "@asyn($(PORT),$(ADDR),$(TIMEOUT))AXIS_TEC_ENABLE")
   field(ZRST, "Disable")
   field(ZRVL, "0")
   field(ONST, "Enable")
   field(ONVL, "1")
}

record(mbbi, "$(P)$(R)TECEnable_RBV")
{
   field(DTYP, "asynInt32")
   field(INP,  "@asyn($(PORT),$(ADDR),$(TIMEOUT))AXIS_TEC_ENABLE")
   field(SCAN, "I/O Intr")
   field(ZRST, "Disable")
   field(ZRVL, "0")
   field(ONST, "Enable")
   field(ONVL, "1")
}

