# RGB888 (value 2) is deliberately NOT offered. This is a mono sensor and selecting
# it wedges the detector: TUCAM_Buf_WaitForFrame returns TUCAMRET_NOT_SUPPORT and
# acquisition stops, and setting the format back to Raw does not recover it because
# the format is applied at Buf_Alloc -- the capture has to be stopped and restarted.
# Measured 2026-07-29. Raw and Usual are bit-identical on this camera, so nothing is
# lost. The driver's frameFormats[] array was reduced to match and now range-checks
# the value, so a stale autosave entry of 2 is rejected rather than acted on.
record(mbbo, "$(P)$(R)FrameFormat")
{
   field(PINI, "YES")
   field(DTYP, "asynInt32")
   field(OUT,  "@asyn($(PORT),$(ADDR),$(TIMEOUT))AXIS_FRAME_FORMAT")
   field(ZRST, "Raw")
   field(ZRVL, "0")
   field(ONST, "Usual")
   field(ONVL, "1")
}

