# --------------------------------------------------------------------------
# SDK frame-ring telemetry. TUIDI_CURRENTBUFFRAMES / TUIDI_TOTALBUFFRAMES,
# both absent from upstream ADTucsen.
#
# This is the dropped-frame early warning, and it is why they exist: the SDK
# ring is only 2 frames deep, which at 33.5 MB per frame and ~8.6 fps is about
# 230 ms of slack. BuffFrames climbing toward BuffTotal means the plugin chain
# is not keeping up and frames are about to be lost.
#
# Read-only counters, so longin rather than the ai used elsewhere in this file
# for the float64 properties.
record(longin, "$(P)$(R)BuffFrames_RBV")
{
   field(DTYP, "asynInt32")
   field(INP,  "@asyn($(PORT),$(ADDR),$(TIMEOUT))AXIS_BUFF_FRAMES")
   field(SCAN, "I/O Intr")
   field(DESC, "Frames currently in SDK ring")
}

record(longin, "$(P)$(R)BuffTotal_RBV")
{
   field(DTYP, "asynInt32")
   field(INP,  "@asyn($(PORT),$(ADDR),$(TIMEOUT))AXIS_BUFF_TOTAL")
   field(SCAN, "I/O Intr")
   field(DESC, "SDK ring capacity in frames")
}
