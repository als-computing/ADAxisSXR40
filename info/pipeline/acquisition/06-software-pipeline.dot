digraph G { rankdir=TB; bgcolor=white; newrank=true; nodesep=0.3; ranksep=0.4;
 node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=11, fillcolor="#f7f7f7"]; edge [fontname="Helvetica", fontsize=10];
 subgraph cluster_sdk { label="libTUCam — the SDK's USB thread"; fontname="Helvetica"; fontsize=11; color="#888888"; style=dashed;
   usb  [label="libusb bulk transfers, always queued"];
   ring [label="ring buffer: 2 slots × frame size", fillcolor="#cfe3f7"];
   usb -> ring [label="reassemble frame"];
 }
 subgraph cluster_drv { label="ADAxisSXR40 — imageGrabTask thread"; fontname="Helvetica"; fontsize=11; color="#888888"; style=dashed;
   wait [label="TUCAM_Buf_WaitForFrame   (port lock released while blocked)"];
   copy [label="check geometry · alloc NDArray from pool · memcpy slot → NDArray\nstamp uniqueId, timestamp, attributes   (port lock held)"];
   cb   [label="doCallbacksGenericPointer — one call per subscribed plugin"];
   wait -> copy -> cb;
 }
 pool [label="NDArrayPool\n1.5 GiB ≈ 48 full frames, reference-counted free list", fillcolor="#d5f0d5"];
 subgraph cluster_plug { label="ADCore plugins — each has its own thread and queue"; fontname="Helvetica"; fontsize=11; color="#888888"; style=dashed;
   q1 [label="HDF1 queue: 21 pointers", fillcolor="#cfe3f7"];
   w1 [label="HDF1 writer thread\nextend dataset · H5Dwrite · append attributes · NumCaptured++ · release NDArray"];
   q2 [label="image1 / ROI / Stats …  EnableCallbacks = Disable → not subscribed", fillcolor="#f0f0f0", fontcolor="#888888"];
   q1 -> w1;
 }
 pc   [label="kernel page cache  (write() returns here — RAM, not disk)", fillcolor="#eeeeee"];
 disk [label="virtual disk — background writeback", fillcolor="#eeeeee"];
 ring -> wait [label="wakes"];
 pool -> copy [label="alloc", style=dashed];
 cb -> q1 [label="pointer + refcount, no copy"];
 cb -> q2 [style=dotted, color="#aaaaaa"];
 w1 -> pc -> disk;
 w1 -> pool [label="release", style=dashed, constraint=false];
 l1 [shape=plaintext, fontcolor="#c0392b", fontsize=10, label="LOSS: grab thread 2 frames late → slot overwritten, uncounted"];
 l2 [shape=plaintext, fontcolor="#c0392b", fontsize=10, label="LOSS: pool exhausted → frame skipped, IOC log only"];
 l3 [shape=plaintext, fontcolor="#c0392b", fontsize=10, label="LOSS: queue full → DroppedArrays++ (the only visible one)"];
 { rank=same; ring; l1; } { rank=same; pool; l2; } { rank=same; q1; l3; }
 ring -> l1 [style=dotted, color="#c0392b", arrowhead=none]; pool -> l2 [style=dotted, color="#c0392b", arrowhead=none]; q1 -> l3 [style=dotted, color="#c0392b", arrowhead=none];
}