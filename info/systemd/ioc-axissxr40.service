# systemd unit for the ADAxisSXR40 IOC -- a mirror of /etc/systemd/system/ioc-xv4040.service
# (Damon English, 2026-08) with the paths, user, service name and console port changed, plus
# a start guard, so the two IOCs can be swapped by stopping one service and starting the other.
#
# NOT installed by the build. To install or update (host-level action, outside this module):
#   sudo cp ioc-axissxr40.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl stop ioc-xv4040          # the camera and PVA port 5075 are exclusive
#   sudo systemctl start ioc-axissxr40
# Do NOT "systemctl enable" it while ioc-xv4040 is the boot-time default.
#
# ExecStart runs ioc-axissxr40-run.sh, which first runs ioc-axissxr40-guard.sh -- refusing
# to start while ioc-xv4040 is active or activating, or while anything already serves
# pvAccess on TCP 5075, with the reason written to the journal and to
# /var/log/areadetector/axisSXR40-guard.log -- then starts procServ and stays as the main
# process: it tells systemd READY once the IOC answers Channel Access, and every
# HEALTH_INTERVAL seconds runs ioc-axissxr40-health.sh and reports the verdict as this
# unit's Status: line ("systemctl status ioc-axissxr40"), e.g.
#   Status: "OK: Idle, camera present, poll 0.4 s old (09:41:12)"
#   Status: "ERROR: DetectorState Error, camera present -- IOC needs a restart ... -- no heartbeat; ..."
# The watchdog heartbeat is sent only for OK and CAMERA ABSENT. When the detector is
# present but the IOC is in Error, hung, or its driver poll is frozen (a camera power
# cycle, the stop deadlock), the heartbeat stops; after WatchdogSec systemd stops the
# service with SIGTERM and Restart= brings it back, which re-opens the camera.
# StartLimitBurst= caps that at 3 restarts per 30 min; then the unit stays "failed"
# ("start request repeated too quickly") until someone runs
#   sudo systemctl reset-failed ioc-axissxr40 && sudo systemctl start ioc-axissxr40
# The health loop lives inside this service: nothing runs while ioc-xv4040 is serving,
# and nothing here reads or acts on his unit.
# This is deliberately NOT Conflicts=ioc-xv4040.service, which would silently stop
# Damon's service; deciding which IOC owns the camera is an operator action.
# The guard exits 75 when it refuses; the launcher passes that up as the main process's
# exit code, and RestartPreventExitStatus=75 below stops Restart=always from re-running
# it every 5 s forever. (It is NOT in ExecStartPre because RestartPreventExitStatus=
# applies only to the main process -- an ExecStartPre failure IS retried.)

[Unit]
Description=EPICS IOC - AXIS-SXR-40 / Tucsen Dhyana XV4040BSI (ADAxisSXR40, areaDetector)
Documentation=file:///usr/local/epics/support/areaDetector/ADAxisSXR40/README.md
# Ordered after ioc-xv4040 so that, if both were ever started in one boot, the
# guard runs after his has finished activating rather than during it.
After=network-online.target ioc-xv4040.service
Wants=network-online.target
# Self-restart budget (watchdog + Restart=always): 3 per 30 min, then "failed" for a person.
StartLimitIntervalSec=1800
StartLimitBurst=3

[Service]
# notify: "active (running)" only once the IOC answers CA; the launcher's health loop
# then owns the Status: line and the watchdog heartbeat. NotifyAccess=all because the
# heartbeat comes from systemd-notify(1) processes forked by the launcher.
Type=notify
NotifyAccess=all
TimeoutStartSec=180
# 200 s = a bit more than three missed 60 s health checks: one slow caget never trips it.
WatchdogSec=200
WatchdogSignal=SIGTERM
Environment=HEALTH_INTERVAL=60
Environment=EPICS_BASE_BIN=/usr/local/epics/base-7.0.10/bin/linux-x86_64
User=gabrielgazolla
Group=gabrielgazolla
WorkingDirectory=/usr/local/epics/support/areaDetector/ADAxisSXR40/iocs/axisSXR40IOC/iocBoot/iocAxisSXR40

# --- pvAccess is the primary transport for images (as ioc-xv4040) -------------
Environment=EPICS_PVAS_INTF_ADDR_LIST=0.0.0.0
Environment="EPICS_PVAS_BEACON_ADDR_LIST=131.243.77.255 192.168.50.255"
Environment=EPICS_PVA_AUTO_ADDR_LIST=YES
Environment=EPICS_PVA_SERVER_PORT=5075
Environment=EPICS_PVA_BROADCAST_PORT=5076
# Channel Access kept working for legacy clients; images should go over PVA.
Environment=EPICS_CA_AUTO_ADDR_LIST=YES
Environment=EPICS_CA_MAX_ARRAY_BYTES=40000000

# Console log goes to /var/log/areadetector/axisSXR40.log. systemd creates that
# directory at every start, owned by User= above, so no sudo mkdir/chown is needed
# and nothing under /var/log/epics (owned by the xv4040 deployment) is touched.
# The directory name is deliberately generic: other areaDetector IOC logs on this
# host, including xv4040's if it ever moves, have a natural home here. The guard
# writes its refusals to axisSXR40-guard.log in the same directory.
LogsDirectory=areadetector

# Launcher: guard, then procServ on telnet localhost:20001 (ioc-xv4040 uses 20000;
# no --allow, so the console is reachable only from this host).
ExecStart=/usr/local/epics/support/areaDetector/ADAxisSXR40/info/systemd/ioc-axissxr40-run.sh

Restart=always
RestartSec=5
# A guard refusal (exit 75) is a deliberate no-start, not a crash: do not retry it.
RestartPreventExitStatus=75
TimeoutStopSec=30
KillSignal=SIGTERM

[Install]
WantedBy=multi-user.target
