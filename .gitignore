# Build output. Everything here is regenerated by `make` and none of it should
# travel in an archive -- see the note about qmake baking absolute paths into
# generated Makefiles in ../QtDemo/README.md.
#
# Modelled on ADSimDetector's .gitignore, the reference areaDetector module.
bin
lib
include
db
dbd
O.*/

# IOC-generated
envPaths*
cdCommands*
dllPath*
auto_settings.sav*

# Site overrides -- intentionally local, never committed
configure/*.local

# The SDK writes a per-camera profile named <Model>_PID<pid>_<SERIAL>.xml into
# whatever directory the IOC runs from.
*_PID*.xml

# Proprietary vendor documentation -- Axis Photonique copyright. The USB User
# Manual and the s/n 702 factory Test Report (PDFs plus their markdown/image
# conversions) came with the instrument and are not ours to redistribute.
# They stay in the local working tree; only this repository goes public.
info/manuals/

# Screenshots of the ALS BCS LabVIEW driver's block diagrams -- effectively
# source code of LBNL-internal software, not for a public repository. The
# written audit alongside them (README.md, RISKS.md, the tsv/txt evidence)
# is our own analysis and stays tracked.
info/labview-vs-epics-analysis/labview-screenshots/

# IOC shell command history
.iocsh_history

# LibreOffice lock files
.~lock.*#

# Editor / OS noise
*~
*.swp
*_BAK.adl
